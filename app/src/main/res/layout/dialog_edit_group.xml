<?xml version="1.0" encoding="utf-8"?>
<!--
  编辑照片组：名称、经纬度、时区。列表页长按与结果页两处共用这一份（见 GroupEditor.kt）。
  与 dialog_new_group 的差别：没有 GPS 定位（这里改的是已有组的记录，不是现场取点），
  多一行时区；半球提示也不放，改完回结果页看冬至/夏至两档即可知道南北。

  三个输入框的 hint 都是数值样例（31.23 / 121.47 / +05:30），不写「经度」「时区」这类字样，
  所以它们在八种语言里是同一份字符串（values/ 里标了 translatable="false"）。
  时区那一行右侧两个图标键是「填本机时区」与「按经度推算」，同样不放文字。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp">

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/stroke2"
        android:hint="@string/group_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:selectAllOnFocus="true"
        android:textColor="@color/paper"
        android:textColorHint="@color/smoke"
        android:textSize="15sp" />

    <!-- 经度在上、纬度在下（顺序与显示端 `Format.coordinate` 一致）。分两行是因为并排时
         每格只剩半幅宽，`121.470000` 这种六位小数会被拦腰截断。
         左边 LON / LAT 是轴名，右边 °E / °N 是半球后缀——后缀跟着输入的正负走，
         填西经或南纬时会变成 °W / °S，不是写死的一串。
         三个输入框都开了 selectAllOnFocus：进焦点全选，再点一下就按原生行为把光标落到点击处 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_lon"
            android:textColor="@color/smoke"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/lonInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/label_longitude_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lonSuffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="18dp"
            android:textColor="@color/moon"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_lat"
            android:textColor="@color/smoke"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/latInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/label_latitude_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/latSuffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="18dp"
            android:textColor="@color/moon"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- editText 的 hint 不会滚动，长一点就被拦腰截断、紧贴着右边的图标键；
             ellipsize 让它以省略号收尾，识别得出「这里还有内容」而不是像被图标签字盖住 -->
        <EditText
            android:id="@+id/zoneInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:ellipsize="end"
            android:hint="@string/label_timezone_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="15sp" />

        <!-- contentDescription 在代码里改成「按下去会填成什么」，XML 里的只是打开前的占位 -->
        <ImageView
            android:id="@+id/zoneDeviceButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/label_timezone_hint"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_zone_device" />

        <ImageView
            android:id="@+id/zoneLongitudeButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:contentDescription="@string/label_timezone_hint"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_zone_longitude" />
    </LinearLayout>

</LinearLayout>
