<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_title"
            android:textColor="@color/paper"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/smoke"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/metaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/smoke"
        android:textSize="10.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/readingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/paper"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/noPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:minWidth="42dp"
            android:paddingStart="8dp"
            android:paddingTop="1dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp"
            android:text="@string/capture_no_photo"
            android:textColor="@color/smoke"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/plus180"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_filled"
            android:gravity="center"
            android:minWidth="42dp"
            android:paddingStart="8dp"
            android:paddingTop="1dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp"
            android:text="@string/capture_plus180"
            android:textColor="@color/ink"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/precisionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/calibPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_precision_pill"
            android:backgroundTint="@color/precision_unknown"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/capture_calib_unknown"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jitterPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_precision_pill"
            android:backgroundTint="@color/precision_unknown"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/capture_jitter_unknown"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rollText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:textColor="@color/smoke"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 可伸缩中段：取景器吃掉所有剩余空间，窗口变矮时先压缩它。
         快门/删除/完成键留在根链末尾，矮窗口（如上下分屏、折叠屏展开）下也不会被挤出屏幕。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <FrameLayout
        android:id="@+id/viewfinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_viewfinder"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <io.github.hecate2.D7.view.ViewfinderOverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipExternal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_on"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/capture_chip_external"
                android:textColor="@color/ink"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/chipCeiling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_off"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/capture_chip_ceiling"
                android:textColor="@color/paper"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/moon"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- 按住快门时出现在准星下方的提示：gravity=center 即取景器中心（准星），
             marginTop 把文字压到准星下面 -->
        <TextView
            android:id="@+id/pressHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="42dp"
            android:background="@drawable/bg_press_hint"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/capture_press_hint"
            android:textColor="@color/paper"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/aimWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_aim_warn"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/capture_below_horizon"
        android:textColor="@color/warn_text"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textColor="@color/smoke"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/hintSeg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/capture_hint_seg"
        android:textColor="@color/moon"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/dirRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dirLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/smoke"
            android:textSize="10sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

        <TextView
            android:id="@+id/dirRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/smoke"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/coverageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/coverageLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/smoke"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/showLinesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/capture_show_lines"
            android:textColor="@color/smoke"
            android:textSize="10sp" />
    </LinearLayout>

    <io.github.hecate2.D7.view.CoverageBarView
        android:id="@+id/coverageBar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="6dp" />

    </LinearLayout>

    <!-- 底部只留这一行：快门提示已并入 hintSeg（原文与它重复），删除的长按提示
         贴在删除键正下方，省掉原先单独的 captionRow 一整行。五个控件都占 52dp、
         顶端对齐，删除键与快门中心线保持一致。
         闪光灯键与对焦键夹在快门两侧，是纯图标键：48dp 见方、无文字，
         宽度写死以便两个文字键（完成/删除）继续用 weight 平分剩余空间。 -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/doneButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_button_light"
                android:gravity="center"
                android:minWidth="58dp"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="@string/capture_done"
                android:textColor="@color/ink"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- 闪光灯（手电筒）键：无闪光灯的机型直接隐藏，不占位 -->
        <FrameLayout
            android:id="@+id/torchSlot"
            android:layout_width="48dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/torchButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/capture_torch"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_torch" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1">

            <View
                android:id="@+id/shutter"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter" />

            <!-- 按住快门时的转圈指示（动画由系统 ProgressBar 驱动，无额外代码与体积） -->
            <ProgressBar
                android:id="@+id/shutterProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/press"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 对焦键：短按立刻对焦一次，长按开关自动对焦 -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/focusButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="@string/capture_focus"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_focus" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <TextView
                    android:id="@+id/deleteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="center"
                    android:minWidth="58dp"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="@string/capture_delete"
                    android:textColor="@color/paper"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/deleteHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:text="@string/capture_delete_hint"
                android:textColor="@color/smoke"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
