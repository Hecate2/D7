<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/titleResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/smoke"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillWinter"
                style="@style/ResultPill"
                android:text="@string/result_pill_winter" />

            <TextView
                android:id="@+id/pillDahan"
                style="@style/ResultPill"
                android:text="@string/result_pill_dahan" />

            <TextView
                android:id="@+id/pillEquinox"
                style="@style/ResultPill"
                android:text="@string/result_pill_equinox" />

            <TextView
                android:id="@+id/pillSummer"
                style="@style/ResultPill"
                android:text="@string/result_pill_summer" />

            <TextView
                android:id="@+id/pillCustom"
                style="@style/ResultPill"
                android:text="@string/result_pill_custom" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipExternalOnly"
                style="@style/ResultChip"
                android:text="@string/result_mode_external" />

            <TextView
                android:id="@+id/chipBoth"
                style="@style/ResultChip"
                android:text="@string/result_mode_both" />

            <TextView
                android:id="@+id/chipCeilingOnly"
                style="@style/ResultChip"
                android:text="@string/result_mode_ceiling" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/mainLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/smoke"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mainValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/paper"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gapNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="3dp"
                    android:text="@string/result_gap_note"
                    android:textColor="@color/moon"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/sunLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/smoke"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result_timeline"
                android:textColor="@color/smoke"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_timeline_legend"
                android:textColor="@color/smoke"
                android:textSize="11sp" />
        </LinearLayout>

        <io.github.hecate2.D7.view.DayTimelineView
            android:id="@+id/dayTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_gb_label"
                android:textColor="@color/smoke"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gbValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/paper"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/gbHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/result_gb_hint"
                android:textColor="@color/smoke"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/result_year_label"
            android:textColor="@color/smoke"
            android:textSize="11sp" />

        <io.github.hecate2.D7.view.YearCurveView
            android:id="@+id/yearCurve"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/result_points"
                android:textColor="@color/smoke"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/pointsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/smoke"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/editPoints"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_tiny"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/result_edit_points"
                android:textColor="@color/paper"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pointList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exportCsvButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/result_export_csv"
                android:textColor="@color/paper"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/exportImageButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/result_export_image"
                android:textColor="@color/paper"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/captureAgainButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/result_go_capture"
            android:textColor="@color/ink"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>