<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp">

    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/stroke2"
        android:hint="@string/group_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/paper"
        android:textColorHint="@color/smoke"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/lonInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/label_longitude_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/latInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/label_latitude_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gpsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/use_gps"
            android:textColor="@color/paper"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gpsStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/smoke"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hemisphereHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/hemisphere_unknown"
        android:textColor="@color/moon"
        android:textSize="12sp" />

</LinearLayout>