<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="10dp"
    android:paddingEnd="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipExternal"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_pill_filled"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/capture_chip_external"
            android:textColor="@color/ink"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chipCeiling"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/capture_chip_ceiling"
            android:textColor="@color/smoke"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/azOffsetInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/bulk_edit_az_offset"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/elOffsetInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/stroke2"
            android:hint="@string/bulk_edit_el_offset"
            android:importantForAutofill="no"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1"
            android:textColor="@color/paper"
            android:textColorHint="@color/smoke"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/applyOffset"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/bulk_edit_apply_offset"
            android:textColor="@color/paper"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/bulkInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/stroke2"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minLines="7"
        android:textColor="@color/paper"
        android:textColorHint="@color/smoke"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/bulkHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bulk_edit_hint"
        android:textColor="@color/smoke"
        android:textSize="11sp" />

</LinearLayout>