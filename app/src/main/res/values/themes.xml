<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 全应用暗色主题：漆黑背景、雾白文字 -->
    <style name="Theme.SevenD" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceVariant">@color/card2</item>
        <item name="colorOnSurface">@color/paper</item>
        <item name="colorOnSurfaceVariant">@color/smoke</item>
        <item name="colorPrimary">@color/paper</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorOutline">@color/stroke2</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:textColorSecondary">@color/smoke</item>
    </style>

<!-- 结果页日期药丸（选中态由代码切 bg_pill_filled 与黑色文字） -->
    <style name="ResultPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:textColor">@color/smoke</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 结果页计算档（选中态由代码切 bg_pill_filled 与黑色文字） -->
    <style name="ResultChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/smoke</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>