<?xml version="1.0" encoding="utf-8"?>
<!-- 返回：一支左向箭头（横杆 + 两支箭头撇），描边式，与手电筒/对焦键同一套线宽与圆头。
     图形横向 3.5–20.5、纵向 4.1–19.9，视觉上以 (12,12) 为中心。
     有些机型没有底部导航键（手势导航或隐藏导航条），这两页必须自带退路。
     运行时用 imageTintList 改色，默认纸白。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="@color/paper"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M4.6,12 L19.4,12"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />

    <path
        android:pathData="M11.4,5.2 L4.6,12 L11.4,18.8"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
