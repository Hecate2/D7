<?xml version="1.0" encoding="utf-8"?>
<!-- 时区快捷键之一：用本机时区。一台手机的描边轮廓（机身 + 底部一道短横），
     描边式，与手电筒/对焦/常亮那批图标同一套线宽与圆头。
     机身横向 6.9–17.1、纵向 2.7–21.3（含描边外扩），以 (12,12) 为中心。
     这个键不放文字：可见界面里与时区相关的字样越少越好，用图标加数值就够了。
     运行时用 contentDescription 写上「按下去会填成什么」，读屏据此报出具体的时区值。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="@color/paper"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 机身：四角各一段圆弧，半径 2.4 -->
    <path
        android:pathData="M9.3,2.7 L14.7,2.7 a2.4,2.4 0 0,1 2.4,2.4 L17.1,18.9 a2.4,2.4 0 0,1 -2.4,2.4
            L9.3,21.3 a2.4,2.4 0 0,1 -2.4,-2.4 L6.9,5.1 a2.4,2.4 0 0,1 2.4,-2.4 Z"
        android:strokeColor="@color/paper"
        android:strokeLineJoin="round"
        android:strokeWidth="1.9" />

    <!-- 机身内下方的短横：没有它，这个轮廓读起来像个充电宝 -->
    <path
        android:pathData="M10.6,18.6 L13.4,18.6"
        android:strokeColor="@color/paper"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />
</vector>
