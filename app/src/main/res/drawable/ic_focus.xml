<?xml version="1.0" encoding="utf-8"?>
<!-- 对焦：四角括号 + 中心圆环 + 四向刻线，与参考图一致。
     括号只占四角、刻线只占四边中点，两者互不相碰；刻线内端压过圆环外沿，
     与参考图里「刻线从圆环长出来」的观感一致。
     图形横向与纵向同为 1.9–22.1，严格正方形。
     运行时用 imageTintList 改色（自动对焦开=琥珀 @color/press，关=月灰 @color/moon）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="@color/moon"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 四角括号 -->
    <path
        android:fillColor="@color/paper"
        android:pathData="M1.9,1.9 L7.0,1.9 L7.0,3.8 L3.8,3.8 L3.8,7.0 L1.9,7.0 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M22.1,1.9 L17.0,1.9 L17.0,3.8 L20.2,3.8 L20.2,7.0 L22.1,7.0 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M1.9,22.1 L7.0,22.1 L7.0,20.2 L3.8,20.2 L3.8,17.0 L1.9,17.0 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M22.1,22.1 L17.0,22.1 L17.0,20.2 L20.2,20.2 L20.2,17.0 L22.1,17.0 Z" />

    <!-- 中心圆环：外径 5.2、内径 3.4，用 evenOdd 挖空 -->
    <path
        android:fillColor="@color/paper"
        android:fillType="evenOdd"
        android:pathData="M12,6.8 a5.2,5.2 0 1,0 0,10.4 a5.2,5.2 0 1,0 0,-10.4 Z M12,8.6 a3.4,3.4 0 1,0 0,6.8 a3.4,3.4 0 1,0 0,-6.8 Z" />

    <!-- 四向刻线，内端压到圆环上 -->
    <path
        android:fillColor="@color/paper"
        android:pathData="M11.1,4.4 L12.9,4.4 L12.9,7.6 L11.1,7.6 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M11.1,19.6 L12.9,19.6 L12.9,16.4 L11.1,16.4 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M4.4,11.1 L7.6,11.1 L7.6,12.9 L4.4,12.9 Z" />
    <path
        android:fillColor="@color/paper"
        android:pathData="M19.6,11.1 L16.4,11.1 L16.4,12.9 L19.6,12.9 Z" />
</vector>
