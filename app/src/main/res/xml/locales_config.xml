<?xml version="1.0" encoding="utf-8"?>
<!--
  系统级「按应用设置语言」的语言清单（Android 13+）。
  当前只发布中文：values/ 即中文默认资源，故此处只声明 zh-Hans。
  将来真正补齐 values-en/ 时，再把 en 加回本清单——在那之前不声明，
  免得用户在系统里选了 English 却拿到中文界面。
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="zh-Hans" />
</locale-config>
